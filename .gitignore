# ==============================================================================
# .gitignore for Error Correction Codes (Verilog + Python)
# ==============================================================================

# --- Agents & Workspace Config ---
.agents/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Xilinx Vivado & Simulation Artifacts ---
*.log
*.jou
*.str
*.pb
*.wdb
*.vcd
*.fsdb
*.vpd
*.dcp
*.bit
*.bin
*.sysdef
*.hwdef

# Vivado generated directories
.Xil/
xsim.dir/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

# Vivado webtalk files
webtalk*.log
webtalk*.jou
webtalk*.xml

# --- Other Verilog Simulators (Icarus, ModelSim, Questa) ---
*.vvp
*.out
work/
transcript
vsim.wlf
modelsim.ini

# --- Operating System & Editor Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Editors & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
